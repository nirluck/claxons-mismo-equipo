# ==========================================================================
# Mismo Equipo · configuracion de Apache para la raiz de www.losclaxons.com
# Equivale a lo que hacia netlify.toml en la copia de trabajo.
# Requiere AllowOverride FileInfo en esta carpeta. Si no esta permitido,
# Apache responde 500 en todo el sitio.
# ==========================================================================

# El repositorio se clona directo en la carpeta publica: su historial y
# los archivos internos no deben servirse.
RedirectMatch 404 "/\.git"
RedirectMatch 404 "/README\.md$"

AddType font/woff2 .woff2
AddCharset utf-8 .html .css .js .svg

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
